# Required application configuration. Copy to .env and replace every value.
SECRET_KEY=replace-with-a-long-random-secret
ADMINS=admin@example.org
DATABASE_URL=mysql://echodata_app:replace-me@127.0.0.1/echodata
UPLOAD_FOLDER=/srv/echodata/uploads
DICOM_SERVER=127.0.0.1
DICOM_AET=ECHODATA_PACS
DICOM_CLIENT=ECHODATA_APP
DICOM_PORT=4242

# Safe defaults
DEBUG=False
SESSION_COOKIE_SECURE=True
MAX_CONTENT_LENGTH=16777216
AI_ALLOW_PHI=False

# Optional integrations
OPENAI_API_KEY=
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USER_NAME=
MAIL_DEFAULT_SENDER=
MAIL_PASSWORD=
CODE_WORD=
ECHODATA_URL=
ECHOVIEW_URL=
ECHOVIEW_USERNAME=
ECHOVIEW_PASSWORD=
